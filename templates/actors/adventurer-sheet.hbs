{{!-- FFXIV TTRPG — Adventurer Sheet v3 (sem helpers custom, dados pré-computados) --}}
<form class="{{cssClass}} ffxiv-sheet ffxiv-adventurer" autocomplete="off">

  {{!-- == HEADER == --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="" />
    <div class="header-info">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Aventureiro" />
      </h1>
      <div class="header-meta">
        <span class="meta-field"><label>Job</label>
          <input name="system.job.name" type="text" value="{{jobName}}" placeholder="ex: Paladin" /></span>
        <span class="meta-field"><label>Raça</label>
          <input name="system.race.name" type="text" value="{{raceName}}" placeholder="ex: Hyur" /></span>
        <span class="meta-field"><label>Lv</label>
          <input name="system.job.level" type="number" value="{{jobLevel}}" min="1" max="60"
            class="level-input" /></span>
      </div>
    </div>
    <button type="button" class="rest-button ffxiv-btn-small" title="Descansar (recupera HP/MP)">
      🌙
    </button>
  </header>

  {{!-- == VITAIS: HP / MP / GAUGE == --}}
  <section class="vitals-section">

    <div class="vital-group">
      <span class="vital-label">❤ HP</span>
      <div class="vital-bar-container">
        <div class="vital-bar hp-bar {{hpColor}}" style="width: {{hpPercent}}%"></div>
      </div>
      <input type="number" name="system.derived.hp.value" class="vital-val" value="{{hpValue}}" min="0"
        max="{{hpMax}}" />
      <span class="vital-sep">/</span>
      <input type="number" name="system.derived.hp.max" class="vital-val" value="{{hpMax}}" min="1" />
    </div>

    <div class="vital-group">
      <span class="vital-label">💧 MP</span>
      <div class="vital-bar-container">
        <div class="vital-bar mp-bar" style="width: {{mpPercent}}%"></div>
      </div>
      <input type="number" name="system.derived.mp.value" class="vital-val" value="{{mpValue}}" min="0"
        max="{{mpMax}}" />
      <span class="vital-sep">/</span>
      <input type="number" name="system.derived.mp.max" class="vital-val" value="{{mpMax}}" min="0" />
    </div>

    {{#if hasGauge}}
    <div class="vital-group">
      <span class="vital-label">⚡ {{gaugeLabel}}</span>
      <div class="vital-bar-container">
        <div class="vital-bar gauge-bar" style="width: {{gaugePercent}}%"></div>
      </div>
      <input type="number" name="system.gauge.current" class="vital-val" value="{{gaugeValue}}" min="0"
        max="{{gaugeMax}}" />
      <span class="vital-sep">/</span>
      <span class="vital-val">{{gaugeMax}}</span>
    </div>
    {{/if}}

  </section>

  {{!-- == ATRIBUTOS PRIMÁRIOS == --}}
  <section class="attributes-section">
    {{#each attributes as |attr key|}}
    <div class="attribute-box">
      <label class="attr-label">{{attr.label}}</label>
      <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}" class="attr-input" min="1"
        max="30" />
      <span class="attr-mod attribute-roll" data-attr="{{key}}" title="Rolar {{attr.label}}">{{attr.modifierStr}}</span>
    </div>
    {{/each}}
  </section>

  {{!-- == DERIVADOS == --}}
  <section class="derived-section">
    <div class="derived-item">
      <label>Defesa</label>
      <input type="number" name="system.derived.defense.value" value="{{defense}}" />
    </div>
    <div class="derived-item">
      <label>Def. Mag.</label>
      <input type="number" name="system.derived.magicDefense.value" value="{{magicDefense}}" />
    </div>
    <div class="derived-item">
      <label>Vel.</label>
      <input type="number" name="system.derived.speed.value" value="{{speed}}" />
    </div>
  </section>

  {{!-- == TABS == --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="combat">⚔ Combate</a>
    <a class="item" data-tab="inventory">🎒 Inventário</a>
    <a class="item" data-tab="effects">✨ Efeitos</a>
    <a class="item" data-tab="bio">📜 Perfil</a>
  </nav>

  <section class="sheet-body">

    {{!-- TAB: COMBATE --}}
    <div class="tab" data-tab="combat">

      {{#if hasCombo}}
      <div class="combo-indicator">🔗 Combo ativo: <strong>{{lastCombo}}</strong></div>
      {{/if}}

      {{#if abilities.primary.length}}
      <h3 class="category-header primary-header">● Ação Primária</h3>
      <ol class="items-list">
        {{#each abilities.primary as |a|}}
        <li class="item" data-item-id="{{a._id}}">
          <img class="item-image" src="{{a.img}}" alt="{{a.name}}" />
          <div class="item-name ability-use">
            <h4>{{a.name}}</h4>
            <small>Lv.{{a.system.level}}{{#if a.system.cost.mp}} | <span class="mp-cost">{{a.system.cost.mp}}
                MP</span>{{/if}}</small>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit" title="Editar">✏</a>
            <a class="item-control item-delete" title="Deletar">🗑</a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{#if abilities.secondary.length}}
      <h3 class="category-header secondary-header">◑ Ação Secundária</h3>
      <ol class="items-list">
        {{#each abilities.secondary as |a|}}
        <li class="item" data-item-id="{{a._id}}">
          <img class="item-image" src="{{a.img}}" alt="{{a.name}}" />
          <div class="item-name ability-use">
            <h4>{{a.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit">✏</a>
            <a class="item-control item-delete">🗑</a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{#if abilities.instant.length}}
      <h3 class="category-header instant-header">⚡ Instant</h3>
      <ol class="items-list">
        {{#each abilities.instant as |a|}}
        <li class="item" data-item-id="{{a._id}}">
          <img class="item-image" src="{{a.img}}" alt="{{a.name}}" />
          <div class="item-name ability-use">
            <h4>{{a.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit">✏</a>
            <a class="item-control item-delete">🗑</a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{#if abilities.passive.length}}
      <h3 class="category-header passive-header">∞ Passivo</h3>
      <ol class="items-list">
        {{#each abilities.passive as |a|}}
        <li class="item" data-item-id="{{a._id}}">
          <img class="item-image" src="{{a.img}}" alt="{{a.name}}" />
          <div class="item-name">
            <h4>{{a.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit">✏</a>
            <a class="item-control item-delete">🗑</a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      <div class="item-add-row">
        <button type="button" class="item-create ffxiv-btn-small" data-type="ability">+ Habilidade</button>
      </div>
    </div>

    {{!-- TAB: INVENTÁRIO --}}
    <div class="tab" data-tab="inventory">
      {{#if weapons.length}}
      <h3 class="category-header">⚔ Armas</h3>
      <ol class="items-list">
        {{#each weapons as |w|}}
        <li class="item" data-item-id="{{w._id}}">
          <img class="item-image" src="{{w.img}}" alt="{{w.name}}" />
          <div class="item-name">
            <h4>{{w.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit">✏</a>
            <a class="item-control item-delete">🗑</a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}
      {{#if consumables.length}}
      <h3 class="category-header">🧪 Consumíveis</h3>
      <ol class="items-list">
        {{#each consumables as |c|}}
        <li class="item" data-item-id="{{c._id}}">
          <img class="item-image" src="{{c.img}}" alt="{{c.name}}" />
          <div class="item-name">
            <h4>{{c.name}}</h4><small>x{{c.system.quantity}}</small>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit">✏</a>
            <a class="item-control item-delete">🗑</a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}
      <div class="item-add-row">
        <button type="button" class="item-create ffxiv-btn-small" data-type="weapon">+ Arma</button>
        <button type="button" class="item-create ffxiv-btn-small" data-type="consumable">+ Consumível</button>
      </div>
    </div>

    {{!-- TAB: EFEITOS --}}
    <div class="tab" data-tab="effects">
      <ol class="effects-list">
        {{#each effects as |e|}}
        <li class="effect-item" data-effect-id="{{e.id}}">
          <img class="effect-icon" src="{{e.icon}}" alt="{{e.label}}" />
          <div class="effect-info">
            <span class="effect-name">{{e.label}}</span>
            {{#if e.rounds}}<span class="effect-duration"> ({{e.rounds}} rounds)</span>{{/if}}
          </div>
          <div class="item-controls">
            <a class="item-control effect-toggle">👁</a>
            <a class="item-control effect-delete">🗑</a>
          </div>
        </li>
        {{/each}}
        {{#unless effects.length}}
        <li class="no-effects">✅ Nenhum efeito ativo</li>
        {{/unless}}
      </ol>
    </div>

    {{!-- TAB: PERFIL --}}
    <div class="tab" data-tab="bio">
      <div class="profile-grid">
        <div class="profile-field">
          <label>Idade</label>
          <input type="text" name="system.profile.age" value="{{profileAge}}" />
        </div>
        <div class="profile-field">
          <label>Altura</label>
          <input type="text" name="system.profile.height" value="{{profileHeight}}" />
        </div>
        <div class="profile-field">
          <label>Divindade</label>
          <input type="text" name="system.profile.deity" value="{{profileDeity}}" />
        </div>
        <div class="profile-field">
          <label>Terra Natal</label>
          <input type="text" name="system.profile.homeland" value="{{profileHomeland}}" />
        </div>
      </div>
      <div class="biography-field">
        <label>Biografia</label>
        <textarea name="system.biography" rows="8">{{biography}}</textarea>
      </div>
    </div>

  </section>
</form>