{{!-- FFXIV TTRPG — Actor Sheet: Adventurer (v2 - sem helpers externos) --}}
<form class="{{cssClass}} ffxiv-sheet ffxiv-adventurer" autocomplete="off">

  {{!-- HEADER --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-info">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="Nome" />
      </h1>
      <div class="header-meta">
        <span class="meta-field">
          <label>Job:</label>
          <input name="system.job.name" type="text" value="{{system.job.name}}" placeholder="Job" />
        </span>
        <span class="meta-field">
          <label>Raça:</label>
          <input name="system.race.name" type="text" value="{{system.race.name}}" placeholder="Raça" />
        </span>
        <span class="meta-field">
          <label>Lv:</label>
          <input name="system.job.level" type="number" value="{{system.job.level}}" min="1" max="60"
            class="level-input" />
        </span>
      </div>
    </div>
  </header>

  {{!-- VITALS: HP, MP --}}
  <section class="vitals-section">

    <div class="vital-group">
      <span class="vital-icon hp-icon"><i class="fas fa-heart"></i> HP</span>
      <div class="vital-bar-container">
        <div class="vital-bar hp-bar {{hpColor}}" style="width: {{hpPercent}}%"></div>
      </div>
      <input type="number" name="system.derived.hp.value" class="hp-input vital-val" value="{{system.derived.hp.value}}"
        min="0" max="{{system.derived.hp.max}}" />
      <span>/</span>
      <input type="number" name="system.derived.hp.max" class="vital-val" value="{{system.derived.hp.max}}" min="1" />
    </div>

    <div class="vital-group">
      <span class="vital-icon mp-icon"><i class="fas fa-droplet"></i> MP</span>
      <div class="vital-bar-container">
        <div class="vital-bar mp-bar" style="width: {{mpPercent}}%"></div>
      </div>
      <input type="number" name="system.derived.mp.value" class="mp-input vital-val" value="{{system.derived.mp.value}}"
        min="0" max="{{system.derived.mp.max}}" />
      <span>/</span>
      <input type="number" name="system.derived.mp.max" class="vital-val" value="{{system.derived.mp.max}}" min="0" />
    </div>

    {{#if system.gauge.max}}
    <div class="vital-group">
      <span class="vital-icon gauge-icon"><i class="fas fa-bolt"></i> {{system.gauge.label}}</span>
      <div class="vital-bar-container">
        <div class="vital-bar gauge-bar" style="width: {{gaugePercent}}%"></div>
      </div>
      <input type="number" name="system.gauge.current" class="gauge-input vital-val" value="{{system.gauge.current}}"
        min="0" max="{{system.gauge.max}}" />
      <span>/</span>
      <span class="vital-val">{{system.gauge.max}}</span>
    </div>
    {{/if}}

  </section>

  {{!-- ATRIBUTOS --}}
  <section class="attributes-section">
    <div class="attribute-box">
      <label class="attr-label">FOR</label>
      <input type="number" name="system.attributes.str.value" value="{{system.attributes.str.value}}" class="attr-input"
        min="1" max="30" />
      <span class="attr-mod attribute-roll" data-attr="str">{{#if (gte attributes.str.modifier
        0)}}+{{/if}}{{attributes.str.modifier}}</span>
    </div>
    <div class="attribute-box">
      <label class="attr-label">DES</label>
      <input type="number" name="system.attributes.dex.value" value="{{system.attributes.dex.value}}" class="attr-input"
        min="1" max="30" />
      <span class="attr-mod attribute-roll" data-attr="dex">{{#if (gte attributes.dex.modifier
        0)}}+{{/if}}{{attributes.dex.modifier}}</span>
    </div>
    <div class="attribute-box">
      <label class="attr-label">VIT</label>
      <input type="number" name="system.attributes.vit.value" value="{{system.attributes.vit.value}}" class="attr-input"
        min="1" max="30" />
      <span class="attr-mod attribute-roll" data-attr="vit">{{#if (gte attributes.vit.modifier
        0)}}+{{/if}}{{attributes.vit.modifier}}</span>
    </div>
    <div class="attribute-box">
      <label class="attr-label">INT</label>
      <input type="number" name="system.attributes.int.value" value="{{system.attributes.int.value}}" class="attr-input"
        min="1" max="30" />
      <span class="attr-mod attribute-roll" data-attr="int">{{#if (gte attributes.int.modifier
        0)}}+{{/if}}{{attributes.int.modifier}}</span>
    </div>
    <div class="attribute-box">
      <label class="attr-label">MEN</label>
      <input type="number" name="system.attributes.mnd.value" value="{{system.attributes.mnd.value}}" class="attr-input"
        min="1" max="30" />
      <span class="attr-mod attribute-roll" data-attr="mnd">{{#if (gte attributes.mnd.modifier
        0)}}+{{/if}}{{attributes.mnd.modifier}}</span>
    </div>
  </section>

  {{!-- DERIVADOS --}}
  <section class="derived-section">
    <div class="derived-item">
      <label>Defesa</label>
      <input type="number" name="system.derived.defense.value" value="{{system.derived.defense.value}}" />
    </div>
    <div class="derived-item">
      <label>Def. Mag.</label>
      <input type="number" name="system.derived.magicDefense.value" value="{{system.derived.magicDefense.value}}" />
    </div>
    <div class="derived-item">
      <label>Velocidade</label>
      <input type="number" name="system.derived.speed.value" value="{{system.derived.speed.value}}" />
    </div>
    <div class="derived-item">
      <button type="button" class="rest-button ffxiv-btn-small" title="Descansar">
        <i class="fas fa-moon"></i> Rest
      </button>
    </div>
  </section>

  {{!-- TABS --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="combat"><i class="fas fa-swords"></i> Combate</a>
    <a class="item" data-tab="inventory"><i class="fas fa-bag-shopping"></i> Inventário</a>
    <a class="item" data-tab="effects"><i class="fas fa-star"></i> Efeitos</a>
    <a class="item" data-tab="bio"><i class="fas fa-scroll"></i> Perfil</a>
  </nav>

  <section class="sheet-body">

    {{!-- TAB: COMBATE --}}
    <div class="tab" data-tab="combat">

      {{#if comboState.lastAbility}}
      <div class="combo-indicator">
        <i class="fas fa-link"></i> Combo ativo: <strong>{{comboState.lastAbility}}</strong>
      </div>
      {{/if}}

      {{!-- Ações Primárias --}}
      {{#if abilities.primary.length}}
      <h3 class="category-header primary-header"><i class="fas fa-circle"></i> Ação Primária</h3>
      <ol class="items-list">
        {{#each abilities.primary as |ability|}}
        <li class="item flexrow" data-item-id="{{ability._id}}">
          <img class="item-image" src="{{ability.img}}" alt="{{ability.name}}" />
          <div class="item-name ability-use">
            <h4>{{ability.name}}</h4>
            <small>Lv.{{ability.system.level}}
              {{#if ability.system.cost.mp}}<span class="mp-cost"> | {{ability.system.cost.mp}} MP</span>{{/if}}
            </small>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" title="Deletar"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{!-- Ações Secundárias --}}
      {{#if abilities.secondary.length}}
      <h3 class="category-header secondary-header"><i class="fas fa-circle-half-stroke"></i> Ação Secundária</h3>
      <ol class="items-list">
        {{#each abilities.secondary as |ability|}}
        <li class="item flexrow" data-item-id="{{ability._id}}">
          <img class="item-image" src="{{ability.img}}" alt="{{ability.name}}" />
          <div class="item-name ability-use">
            <h4>{{ability.name}}</h4>
            <small>Lv.{{ability.system.level}}</small>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{!-- Instantâneas --}}
      {{#if abilities.instant.length}}
      <h3 class="category-header instant-header"><i class="fas fa-bolt"></i> Instant</h3>
      <ol class="items-list">
        {{#each abilities.instant as |ability|}}
        <li class="item flexrow" data-item-id="{{ability._id}}">
          <img class="item-image" src="{{ability.img}}" alt="{{ability.name}}" />
          <div class="item-name ability-use">
            <h4>{{ability.name}}</h4>
            <small>Lv.{{ability.system.level}}</small>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{!-- Passivas --}}
      {{#if abilities.passive.length}}
      <h3 class="category-header passive-header"><i class="fas fa-infinity"></i> Passivo</h3>
      <ol class="items-list">
        {{#each abilities.passive as |ability|}}
        <li class="item flexrow" data-item-id="{{ability._id}}">
          <img class="item-image" src="{{ability.img}}" alt="{{ability.name}}" />
          <div class="item-name">
            <h4>{{ability.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      <div class="item-add-row">
        <button type="button" class="item-create ffxiv-btn-small" data-type="ability">
          <i class="fas fa-plus"></i> Adicionar Habilidade
        </button>
      </div>
    </div>

    {{!-- TAB: INVENTÁRIO --}}
    <div class="tab" data-tab="inventory">
      {{#if weapons.length}}
      <h3 class="category-header">⚔ Armas</h3>
      <ol class="items-list">
        {{#each weapons as |w|}}
        <li class="item flexrow" data-item-id="{{w._id}}">
          <img class="item-image" src="{{w.img}}" />
          <div class="item-name">
            <h4>{{w.name}}</h4>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{#if consumables.length}}
      <h3 class="category-header">🧪 Consumíveis</h3>
      <ol class="items-list">
        {{#each consumables as |c|}}
        <li class="item flexrow" data-item-id="{{c._id}}">
          <img class="item-image" src="{{c.img}}" />
          <div class="item-name">
            <h4>{{c.name}}</h4><small>x{{c.system.quantity}}</small>
          </div>
          <div class="item-controls">
            <a class="item-control item-edit"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{#unless weapons.length}}
      {{#unless consumables.length}}
      <p class="no-effects" style="padding:16px; text-align:center; color:#666">Nenhum item no inventário.</p>
      {{/unless}}
      {{/unless}}

      <div class="item-add-row">
        <button type="button" class="item-create ffxiv-btn-small" data-type="weapon">
          <i class="fas fa-plus"></i> Arma
        </button>
        <button type="button" class="item-create ffxiv-btn-small" data-type="consumable">
          <i class="fas fa-plus"></i> Consumível
        </button>
      </div>
    </div>

    {{!-- TAB: EFEITOS --}}
    <div class="tab" data-tab="effects">
      <ol class="effects-list">
        {{#each effects as |effect|}}
        <li class="effect-item flexrow" data-effect-id="{{effect.id}}">
          <img class="effect-icon" src="{{effect.icon}}" alt="{{effect.label}}" />
          <div class="effect-info">
            <span class="effect-name">{{effect.label}}</span>
            {{#if effect.duration.rounds}}
            <span class="effect-duration"> ({{effect.duration.rounds}} rounds)</span>
            {{/if}}
          </div>
          <div class="item-controls">
            <a class="item-control effect-toggle"><i class="fas fa-eye"></i></a>
            <a class="item-control effect-delete"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
        {{#unless effects.length}}
        <li class="no-effects">
          <i class="fas fa-check-circle"></i> Nenhum efeito ativo
        </li>
        {{/unless}}
      </ol>
    </div>

    {{!-- TAB: PERFIL --}}
    <div class="tab" data-tab="bio">
      <div class="profile-grid">
        <div class="profile-field">
          <label>Idade</label>
          <input type="text" name="system.profile.age" value="{{system.profile.age}}" />
        </div>
        <div class="profile-field">
          <label>Altura</label>
          <input type="text" name="system.profile.height" value="{{system.profile.height}}" />
        </div>
        <div class="profile-field">
          <label>Divindade</label>
          <input type="text" name="system.profile.deity" value="{{system.profile.deity}}" />
        </div>
        <div class="profile-field">
          <label>Terra Natal</label>
          <input type="text" name="system.profile.homeland" value="{{system.profile.homeland}}" />
        </div>
      </div>
      <div class="biography-field">
        <label>Biografia</label>
        <textarea name="system.biography" rows="8"
          style="width:100%; resize:vertical; background:rgba(0,0,0,0.3); color:#e0d7c0; border-color:#c8a84b55; border-radius:4px; padding:6px;">{{system.biography}}</textarea>
      </div>
    </div>

  </section>
</form>