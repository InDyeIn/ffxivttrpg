{{!-- FFXIV TTRPG — Item Sheet: Ability (sem helpers externos) --}}
<form class="{{cssClass}} ffxiv-sheet ffxiv-item ability-item" autocomplete="off">

    <header class="sheet-header item-header">
        <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
        <div class="header-info">
            <h1><input name="name" type="text" value="{{item.name}}" placeholder="Nome da Habilidade" /></h1>
            <div class="header-meta">
                <span>Job: <input name="system.job" type="text" value="{{system.job}}" style="width:90px" /></span>
                <span>Lv: <input type="number" name="system.level" value="{{system.level}}" min="1" max="60"
                        style="width:45px" /></span>
            </div>
        </div>
    </header>

    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="details">Detalhes</a>
        <a class="item" data-tab="description">Descrição</a>
    </nav>

    <section class="sheet-body">

        <div class="tab" data-tab="details">
            <div class="form-grid">

                <div class="form-group">
                    <label>Tipo de Ação</label>
                    <select name="system.actionType">
                        <option value="primary" {{#if (eq system.actionType "primary" )}}selected{{/if}}>Ação Primária
                        </option>
                        <option value="secondary" {{#if (eq system.actionType "secondary" )}}selected{{/if}}>Ação
                            Secundária</option>
                        <option value="instant" {{#if (eq system.actionType "instant" )}}selected{{/if}}>Instantânea
                        </option>
                        <option value="passive" {{#if (eq system.actionType "passive" )}}selected{{/if}}>Passivo
                        </option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Alcance</label>
                    <select name="system.range">
                        <option value="melee" {{#if (eq system.range "melee" )}}selected{{/if}}>Corpo a Corpo</option>
                        <option value="short" {{#if (eq system.range "short" )}}selected{{/if}}>Curto</option>
                        <option value="medium" {{#if (eq system.range "medium" )}}selected{{/if}}>Médio</option>
                        <option value="long" {{#if (eq system.range "long" )}}selected{{/if}}>Longo</option>
                        <option value="self" {{#if (eq system.range "self" )}}selected{{/if}}>Próprio</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Alvo</label>
                    <select name="system.target">
                        <option value="single" {{#if (eq system.target "single" )}}selected{{/if}}>Alvo Único</option>
                        <option value="self" {{#if (eq system.target "self" )}}selected{{/if}}>Próprio</option>
                        <option value="all_allies" {{#if (eq system.target "all_allies" )}}selected{{/if}}>Todos os
                            Aliados</option>
                        <option value="all_enemies" {{#if (eq system.target "all_enemies" )}}selected{{/if}}>Todos os
                            Inimigos</option>
                        <option value="aoe" {{#if (eq system.target "aoe" )}}selected{{/if}}>AOE</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Custo MP</label>
                    <input type="number" name="system.cost.mp" value="{{system.cost.mp}}" min="0" />
                </div>

                <div class="form-group">
                    <label>Custo Gauge</label>
                    <input type="number" name="system.cost.gauge" value="{{system.cost.gauge}}" min="0" />
                </div>

                <div class="form-group">
                    <label>Tipo de Dano</label>
                    <select name="system.damage.type">
                        <option value="physical" {{#if (eq system.damage.type "physical" )}}selected{{/if}}>Físico
                        </option>
                        <option value="magic" {{#if (eq system.damage.type "magic" )}}selected{{/if}}>Mágico</option>
                        <option value="holy" {{#if (eq system.damage.type "holy" )}}selected{{/if}}>Sagrado</option>
                        <option value="dark" {{#if (eq system.damage.type "dark" )}}selected{{/if}}>Trevas</option>
                        <option value="fire" {{#if (eq system.damage.type "fire" )}}selected{{/if}}>Fogo</option>
                        <option value="ice" {{#if (eq system.damage.type "ice" )}}selected{{/if}}>Gelo</option>
                        <option value="lightning" {{#if (eq system.damage.type "lightning" )}}selected{{/if}}>Raio
                        </option>
                        <option value="wind" {{#if (eq system.damage.type "wind" )}}selected{{/if}}>Vento</option>
                        <option value="unaspected" {{#if (eq system.damage.type "unaspected" )}}selected{{/if}}>Sem
                            Aspecto</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Atributo</label>
                    <select name="system.damage.attribute">
                        <option value="str" {{#if (eq system.damage.attribute "str" )}}selected{{/if}}>FOR</option>
                        <option value="dex" {{#if (eq system.damage.attribute "dex" )}}selected{{/if}}>DES</option>
                        <option value="int" {{#if (eq system.damage.attribute "int" )}}selected{{/if}}>INT</option>
                        <option value="mnd" {{#if (eq system.damage.attribute "mnd" )}}selected{{/if}}>MEN</option>
                        <option value="vit" {{#if (eq system.damage.attribute "vit" )}}selected{{/if}}>VIT</option>
                    </select>
                </div>

            </div>

            <fieldset class="damage-section">
                <legend>⚔️ Dano / Cura</legend>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Fórmula de Dano</label>
                        <input type="text" name="system.damage.formula" value="{{system.damage.formula}}"
                            placeholder="ex: 2d6" />
                    </div>
                    <div class="form-group">
                        <label>Fórmula de Cura</label>
                        <input type="text" name="system.healing.formula" value="{{system.healing.formula}}"
                            placeholder="ex: 2d6" />
                    </div>
                    <div class="form-group">
                        <label>Fórmula de Shield</label>
                        <input type="text" name="system.shield.formula" value="{{system.shield.formula}}"
                            placeholder="ex: 1d6" />
                    </div>
                </div>
            </fieldset>

            <fieldset class="combo-section">
                <legend>🔗 Combo</legend>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Requer (habilidade anterior)</label>
                        <input type="text" name="system.combo.requires" value="{{system.combo.requires}}"
                            placeholder="Nome da habilidade" />
                    </div>
                    <div class="form-group">
                        <label>Habilita próximas</label>
                        <input type="text" name="system.combo.enables" value="{{system.combo.enables}}"
                            placeholder="Nomes separados por vírgula" />
                    </div>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="system.combo.isOpener" {{#if
                            system.combo.isOpener}}checked{{/if}} />
                        É Opener (inicia do zero)?
                    </label>
                </div>
            </fieldset>

            <fieldset class="positional-section">
                <legend>📍 Posicionais</legend>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Flanco (bônus)</label>
                        <input type="text" name="system.positional.flank" value="{{system.positional.flank}}"
                            placeholder="ex: +1d6" />
                    </div>
                    <div class="form-group">
                        <label>Traseiro (bônus)</label>
                        <input type="text" name="system.positional.rear" value="{{system.positional.rear}}"
                            placeholder="ex: auto_crit" />
                    </div>
                </div>
            </fieldset>
        </div>

        <div class="tab" data-tab="description">
            <div class="form-group">
                <label>Descrição</label>
                <textarea name="system.description" rows="12"
                    style="width:100%; resize:vertical; background:rgba(0,0,0,0.3); color:#e0d7c0; border:1px solid #c8a84b55; border-radius:4px; padding:8px;">{{system.description}}</textarea>
            </div>
        </div>

    </section>
</form>